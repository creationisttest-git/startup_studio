# Copy to .board.env and fill in. Names here, values never.
#
# ADD .board.env TO .gitignore BEFORE THE FIRST COMMIT, not after. A credential removed after
# it lands is a history rewrite, not a delete, and it stays valid until it is rotated.

# The board backend. Project Settings > API.
SUPABASE_URL=https://<ref>.supabase.co

# The publishable / anon key, the long eyJ... string labelled `anon` `public`.
# Safe to hold and safe to publish: it is governed by row-level security and holds no grants.
SUPABASE_ANON_KEY=

# NEVER put a service-role key in this file or in this environment. It bypasses row-level
# security by definition, so it would give this project access to every other board and no
# policy could take it back. board-cli.js refuses to start if it finds one.

# This project's slug in board_project.
BOARD_PROJECT=<your-slug>

# The bot user for THIS project only. One bot per project, never shared.
BOARD_BOT_EMAIL=bot+<your-slug>@<your-domain>
BOARD_BOT_PASSWORD=

# Only needed by deploy.js.
BOARD_PAGES_PROJECT=<your-slug>-board

# Only if the board has been changed to sign itself in as a shared viewer account instead of
# per-person sign-in. This password IS published inside the page, so it must be a different
# account from the bot above. deploy.js refuses if they match.
BOARD_VIEWER_EMAIL=
BOARD_VIEWER_PASSWORD=
