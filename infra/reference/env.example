# Copy to .env.local and fill in. Commit THIS file; never commit .env.local.
#
# The prefix is a security boundary, not a naming style.
#
# NEXT_PUBLIC_*  is inlined into the browser bundle at build time. Public by definition.
#                Anyone can read it with view-source. Only ever put values here that you
#                would print on the home page.
#
# everything else stays server-side, available in route handlers, server components and
#                platform functions, and never shipped to a client.
#
# A service-role key, an admin token or a signing secret with a NEXT_PUBLIC_ prefix is a
# disclosed credential. Rotate it rather than renaming it, because the old value is already
# in a build artefact somewhere.

# ---------------------------------------------------------------- database and auth

# Safe in the browser. Row-level security is what protects the data, not this key.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Bypasses every row-level security policy you have written.
# If this reaches a client bundle, the database is fully readable and writable by anyone.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------- site

# Used for canonical URLs, sitemaps, share cards and auth redirects.
NEXT_PUBLIC_SITE_URL=https://example.com

# ---------------------------------------------------------------- analytics

NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# ---------------------------------------------------------------- integrations
#
# Server only, every one of them. Add as needed and delete what the project does not use;
# an env.example listing keys nobody sets teaches the next person the wrong shape.

# RESEND_API_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------- local admin
#
# If the project has an admin surface, gate it with a server-side secret checked inside a
# route handler or platform function. Never in client code: a static page is public output,
# so a check that runs in the browser is a suggestion, not a control.

# ADMIN_ACCESS_TOKEN=
